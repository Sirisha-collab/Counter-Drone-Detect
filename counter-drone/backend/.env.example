# --- Database ---------------------------------------------------------
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://cuas:cuas@localhost:5432/cuas

# --- Simulated sensor site -------------------------------------------
SENSOR_NAME=SENTINEL-1
SENSOR_LAT=37.7749
SENSOR_LON=-122.4194
DETECTION_RANGE_M=3000
ALERT_RADIUS_M=900

# --- Simulator --------------------------------------------------------
TICK_SECONDS=2.0
MIN_ACTIVE_OBJECTS=3
MAX_ACTIVE_OBJECTS=9
SPAWN_CHANCE=0.35
HISTORY_LENGTH=40
TRACK_TIMEOUT_SECONDS=12

# --- ML ---------------------------------------------------------------
MODEL_PATH=models/classifier.joblib
MIN_POINTS_FOR_CLASSIFICATION=4

# --- API --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Classifier backend ------------------------------------------------
# "sklearn" (random forest, default) or "torch" (GRU sequence model)
CLASSIFIER_BACKEND=sklearn
TORCH_MODEL_PATH=models/classifier_gru.pt
